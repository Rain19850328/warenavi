# 이 파일을 같은 폴더에 ".env" 라는 이름으로 복사한 뒤 값을 채운다. (.env 는 git에 올라가지 않는다)

# 창고네비 DB (Supabase 대시보드 → Project Settings → API)
SUPABASE_URL=https://rmcrceiuvecbmnyuhsbz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 플레이오토 API (GitHub Secrets 의 PLAYAUTO_* 와 같은 값)
PLAYAUTO_API_KEY=
PLAYAUTO_EMAIL=
PLAYAUTO_PASSWORD=
# 배송처 코드. 플레이오토 조회 결과를 먼저 쓰므로 비워 둬도 된다.
PLAYAUTO_DEPOT_NO=

# 대기 목록을 확인하는 간격(초, 최소 15)
WORKER_INTERVAL_SECONDS=60
